# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo para npm run db:seed (no exponer en cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — Ask Makina AI (opcional)
OPENAI_API_KEY=sk-your-openai-key

# Enriquecimiento de artistas/temas (opcional)
# Discogs: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=your-discogs-personal-access-token
# YouTube Data API v3: https://console.cloud.google.com
YOUTUBE_API_KEY=your-youtube-api-key

# SEO y URLs canónicas
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron diario (Vercel): genera un secreto aleatorio
CRON_SECRET=genera-un-secreto-largo-aqui
