# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo para npm run db:seed (no exponer en cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI — opcional, desbloquea Ask Makina AI y enriquecimiento de bios
# 1. Cuenta en https://platform.openai.com
# 2. Billing → añadir método de pago (pay-as-you-go, muy barato con gpt-4o-mini)
# 3. API Keys → Create secret key
# 4. Local: CLAVES-SUPABASE.env | Producción: Vercel → Environment Variables
OPENAI_API_KEY=sk-your-openai-key

# Enriquecimiento de artistas/temas (opcional)
# Discogs: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=your-discogs-personal-access-token
# YouTube Data API v3: https://console.cloud.google.com
YOUTUBE_API_KEY=your-youtube-api-key

# SEO y URLs canónicas
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron diario (Vercel): genera un secreto aleatorio
CRON_SECRET=genera-un-secreto-largo-aqui

# Newsletter — digest semanal vía Resend (https://resend.com)
# 1. Crea cuenta → API Keys → Create API Key
# 2. Verifica un dominio o usa onboarding@resend.dev solo para pruebas
RESEND_API_KEY=re_your-resend-api-key
NEWSLETTER_FROM_EMAIL=Makina Hub <newsletter@tudominio.com>

# Analyzr Vinyl — URLs de descarga cuando publiques
NEXT_PUBLIC_ANALYZR_VINYL_FREE_URL=
NEXT_PUBLIC_ANALYZR_VINYL_PRO_URL=
# Alias legacy (opcional)
NEXT_PUBLIC_ANALYZR_APP_STORE_URL=
NEXT_PUBLIC_ANALYZR_FREE_URL=
NEXT_PUBLIC_ANALYZR_PRO_URL=
